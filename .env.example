# Puerto en el que escucha el proxy (nginx hará proxy_pass hacia aquí)
PORT=3000

# Valor exacto que Gitea debe enviar en el header "Authorization".
# Configúralo igual en Gitea (Settings -> Webhooks -> Authorization header).
GITEA_AUTH_HEADER=changeme-secreto-A

# Secret configurado en el webhook de Gitea, usado para verificar la firma
# HMAC-SHA256 del header "X-Gitea-Signature".
GITEA_WEBHOOK_SECRET=changeme-secreto-gitea

# ID de la rutina de Claude Code (parte de la URL /routines/{ROUTINE_ID}/fire)
ROUTINE_ID=trig_xxxxxxxxxxxxxxxxxxxxxxxx

# Token de la rutina (sk-ant-oat01-...), se envía como "Authorization: Bearer <token>"
ROUTINE_TOKEN=sk-ant-oat01-changeme

# TTL en milisegundos para el dedup en memoria de entregas de Gitea (X-Gitea-Delivery)
DEDUP_TTL_MS=300000

# Timeout en milisegundos para la llamada a la API de Anthropic (evita que se
# quede colgada indefinidamente si no hay salida a internet)
FIRE_TIMEOUT_MS=10000
